{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "primary-gouge-instructor-reviews",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-28",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 15 * * 1"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "primary-gouge-instructor-reviews",
      "database_id": "9b4c7075-7927-4b5c-8903-39e956d4ab1a",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ACCESS_TOKEN_TTL_SECONDS": "43200",
    "REFRESH_TOKEN_TTL_SECONDS": "2592000",
    "AUTO_MODERATION_MAX_BATCH": "40",
    "ENABLE_AI_MODERATION": "false",
    "AI_MODERATION_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  }
}

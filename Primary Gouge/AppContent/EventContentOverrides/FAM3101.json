            "text": "landing pattern (approach turn and landing attitude) stalls"
          },
          {
            "text": "intentional spin entry"
          },
          {
            "text": "incipient spin recovery"
          },
          {
            "text": "steady-state spin recovery"
          }
        ]
      }
    ]
  },
  "summary": "Normal takeoffs, local departures, scan technique, turns, speed changes, stalls, and spin fundamentals.",
  "title": "Basic Contact Maneuvers"

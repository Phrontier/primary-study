            ],
            "text" : "CHOP:"
          },
          {
            "children" : [
              {
                "text" : "Extend speed brake as required."
              }
            ],
            "text" : "POP:"
          },
          {
            "children" : [
              {
                "text" : "Verify below 150 KIAS."
              }
            ],
            "text" : "CHECK:"

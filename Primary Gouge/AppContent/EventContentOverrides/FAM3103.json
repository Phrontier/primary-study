  "code" : "FAM3103",
  "overview" : "This event introduces crosswind operations and runway emergencies. You will practice crosswind takeoffs, crosswind landings, touch-and-gos, full-stop landings, aborts, and runway departures while learning how to stay aligned with the runway and make early decisions when things are no longer stable.",
  "primaryDocumentTitles" : [
    "FAM3103",
    "FAM 3103 Briefing Guide 1542.166D"
  ],
  "studyNotes" : {
    "headline" : "Discussion Items",
    "sections" : [
      {
        "items" : [
          {
            "children" : [
              {
                "text" : "Dry runway: 25 knot crosswind component."
              },
              {
                "text" : "Wet runway: 10 knot crosswind component."
              },
              {
                "text" : "Icy runway: 5 knot crosswind component."
              },
              {
                "text" : "Maximum takeoff tailwind: 10 knots."
              }
            ],
            "text" : "NATOPS Limits:"
          },
          {
            "children" : [
              {
                "text" : "10 knot maximum crosswind component."
              },
              {
                "text" : "No tailwind component."
              },
              {
                "text" : "25 knot steady winds or 30 knot gusts."
              }
            ],
            "text" : "Solo Limits:"
          },
          {
            "children" : [
              {
                "text" : "Use takeoff flaps for crosswinds greater than 10 knots or gusty conditions."
              },
              {
                "text" : "Consider no-flap landings for crosswinds greater than 20 knots if runway length allows."
              }
            ],
            "text" : "Flap recommendations:"
          }
        ],
        "title" : "Crosswind Limits"
      },
      {
        "items" : [
          {
            "text" : "Determine the angle between runway heading and wind direction."
          },
          {
            "children" : [
              {
                "text" : "NATOPS chart."
              },
              {
                "text" : "PCL crosswind chart."
              },
              {
                "text" : "IFG crosswind table."
              }
            ],
            "text" : "Estimate headwind and crosswind components using:"
          },
          {
            "children" : [
              {
                "text" : "15 degrees off runway heading is approximately 25% of the wind."
              },
              {
                "text" : "30 degrees is approximately 50%."
              },
              {
                "text" : "45 degrees is approximately 75%."
              },
              {
                "text" : "60 degrees or greater is nearly full value."
              }
            ],
            "text" : "Quick mental rules:"
          },
          {
            "children" : [
              {
                "text" : "Runway 05."
              },
              {
                "text" : "Winds 020 at 10 knots."
              },
              {
                "text" : "Crosswind component approximately 5 knots."
              }
            ],
            "text" : "Example:"
          }
        ],
        "title" : "Crosswind Computations"
      },
      {
        "items" : [
          {
            "children" : [
              {
                "text" : "Note wind direction from tower and windsock."
              },
              {
                "text" : "Anticipate required aileron and rudder inputs."
              },
              {
                "text" : "Position aileron into the wind."
              }
            ],
            "text" : "Before takeoff:"
          },
          {
            "children" : [
              {
                "text" : "Use up to full aileron into the wind initially."
              },
              {
                "text" : "Reduce aileron input as speed increases."
              },
              {
                "text" : "Use rudder to maintain runway centerline and counter weathervaning."
              }
            ],
            "text" : "Takeoff roll:"
          },
          {
            "children" : [
              {
                "text" : "Rotate firmly at 90 KIAS."
              },
              {
                "text" : "Prevent skipping by keeping the upwind wing from rising."
              },
              {
                "text" : "Maintain coordinated flight through liftoff."
              }
            ],
            "text" : "Rotation:"
          },
          {
            "children" : [
              {
                "text" : "Level the wings."
              },
              {
                "text" : "Allow the aircraft to crab into the wind."
              },
              {
                "text" : "Keep the ball centered."
              }
            ],
            "text" : "Initial climb:"
          },
          {
            "children" : [
              {
                "text" : "Not using enough aileron."
              },
              {
                "text" : "Not reducing aileron as speed increases."
              },
              {
                "text" : "Using poor rudder control."
              },
              {
                "text" : "Allowing the aircraft to skip sideways."
              }
            ],
            "text" : "Common errors:"
          }
        ],
        "title" : "Crosswind Takeoff"
      },
      {
        "items" : [
          {
            "text" : "Crab into the wind on upwind and downwind to maintain the desired ground track."
          },
          {
            "children" : [
              {
                "text" : "Push the aircraft outside of normal final."
              },
              {
                "text" : "Require slightly more bank and slightly lower power in the final turn."
              }
            ],
            "text" : "Overshooting winds:"
          },
          {
            "children" : [
              {
                "text" : "Push the aircraft inside of normal final."
              },
              {
                "text" : "Require slightly less bank and slightly more power in the final turn."
              }
            ],
            "text" : "Undershooting winds:"
          },
          {
            "children" : [
              {
                "text" : "Normal AOB is approximately 30 degrees."
              },
              {
                "text" : "Maximum AOB is 45 degrees."
              },
              {
                "text" : "If more than 45 degrees is required, waveoff."
              }
            ],
            "text" : "Final turn:"
          },
          {
            "children" : [
              {
                "text" : "Increase final approach speed by one half the gust factor."
              },
              {
                "text" : "Maximum speed increase is 10 knots."
              }
            ],
            "text" : "Gusty conditions:"
          }
        ],
        "title" : "Pattern Adjustments for Crosswinds"
      },
      {
        "items" : [
          {
            "children" : [
              {
                "text" : "Use the wing-low method."
              },
              {
                "text" : "Apply aileron into the wind to stop drift."
              },
              {
                "text" : "Use rudder to align the nose with the runway."
              },
              {
                "text" : "Add power as required to counter additional drag."
              }
            ],
            "text" : "Final:"
          },
          {
            "children" : [
              {
                "text" : "Maintain the upwind wing low."
              },
              {
                "text" : "Do not level the wings before touchdown."
              },
              {
                "text" : "Continue using rudder to keep the nose aligned."
              }
            ],
            "text" : "Flare:"
          },
          {
            "children" : [
              {
                "text" : "Land on the upwind main gear first."
              },
              {
                "text" : "Avoid landing with side motion or while crabbed."
              }
            ],
            "text" : "Touchdown:"
          },
          {
            "children" : [
              {
                "text" : "Continue increasing aileron into the wind as speed decreases."
              },
              {
                "text" : "Use rudder and brakes to maintain centerline."
              },
              {
                "text" : "Avoid braking above 80 KIAS."
              }
            ],
            "text" : "Rollout:"
          },
          {
            "children" : [
              {
                "text" : "Landing in a crab."
              },
              {
                "text" : "Releasing crosswind controls after touchdown."
              },
              {
                "text" : "Overcorrecting back toward centerline."
              },
              {
                "text" : "Failing to waveoff when unstable."
              }
            ],
            "text" : "Common errors:"
          }
        ],
        "title" : "Crosswind Landings"
      },
      {
        "items" : [
          {
            "text" : "Maintain crosswind controls during rollout."
          },
          {
            "text" : "Keep aileron into the wind."
          },
          {
            "text" : "Smoothly advance PCL to MAX."
          },
          {
            "text" : "Rotate at 90 KIAS."
          },
          {
            "children" : [
              {
                "text" : "Level the wings."
              },
              {
                "text" : "Crab into the wind."
              },
              {
                "text" : "Maintain coordinated flight."
              }
            ],
            "text" : "After liftoff:"
          }
        ],
        "title" : "Crosswind T&Gs"
      },
      {
        "items" : [
          {
            "text" : "Maintain aileron into the wind throughout rollout."
          },
          {
            "text" : "Keep directional control with rudder and brakes."
          },
          {
            "text" : "Lower the nosewheel smoothly."
          },
          {
            "text" : "Do not use brakes aggressively."
          },
          {
            "text" : "Continue crosswind corrections until clear of the runway."
          }
        ],
        "title" : "Crosswind Full-Stop Landing"
      },
      {
        "items" : [
          {
            "text" : "Used for any unsafe condition before maximum abort speed."

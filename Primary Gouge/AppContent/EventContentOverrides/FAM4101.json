          {
            "children" : [
              {
                "text" : "Procedure:"
              },
              {
                "text" : "Recovery must be completed above 6000’ AGL"
              },
              {
                "text" : "Establish - level flight, normal\/slow cruise on any numbered heading"
              },
              {
                "text" : "Rollouts\/Reversal - use ⅓ rule, maintain trim, anticipate nose-drop"
              },
              {
                "text" : "Complete - return to original heading, reset cruise power, re-trim"
              },
              {
                "text" : "Use PAT"
              },
              {
                "text" : "Check area before\/during each turn"
              },
              {
                "text" : "Scan horizon and instruments (don’t fixate)"
              },
              {
                "text" : "Use back pressure in steeper turns, forward stick on rollout to prevent ballooning"
              },
              {
                "text" : "Abrupt or premature control inputs"
              },
              {
                "text" : "Inconsistent nose attitude"
              },
              {
                "text" : "Fixation (especially on PFD)"
